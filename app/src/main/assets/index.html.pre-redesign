<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lockhart Local</title><style>
:root{color-scheme:dark;font-family:system-ui;background:#10151b;color:#e9f1f8}*{box-sizing:border-box}body{margin:0;padding:16px;max-width:900px;margin:auto}header{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}h1{font-size:25px;margin:0}h2{font-size:18px;margin:0 0 12px}.muted{color:#9eaebe;font-size:13px}.panel{background:#1c2530;border:1px solid #344151;border-radius:15px;padding:16px;margin:14px 0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.tile{padding:14px;background:#121a23;border-radius:12px}.value{font-size:35px;font-weight:750;margin-top:6px}.chip{border-radius:30px;padding:8px 12px;background:#523c31;font-size:13px}.chip.ok{background:#23553c}.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}input,select,button{padding:11px;border-radius:8px;background:#101720;color:white;border:1px solid #596a7b;font:inherit}button{background:#295e81}input[type=number]{width:90px}input[type=text]{width:150px}canvas{width:100%;height:220px;background:#121a23;border-radius:10px}.flags{display:flex;gap:8px;flex-wrap:wrap}.flag{background:#101720;padding:7px 10px;border-radius:7px;font-size:12px}.on{background:#23553c}.warn{color:#f1c178}label{font-size:13px}.rule{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:9px 0}.rule input{width:80px}.note{font-size:13px;color:#b5c5d4}#events{white-space:pre-wrap;max-height:140px;overflow:auto;font-size:12px}.legend{display:flex;gap:10px;flex-wrap:wrap}.legend label{display:flex;align-items:center;gap:4px}@media(max-width:420px){body{padding:10px}.panel{padding:12px}.value{font-size:29px}}
</style></head><body>
<header><div><h1>🔥 Lockhart Local</h1><div class="muted">PB2180LK · Android → Wi-Fi → grill</div></div><div id="status" class="chip">Connecting…</div></header>
<section class="panel"><div class="row"><label>Grill IP <input type="text" id="ip" inputmode="decimal" value="192.168.1.153"></label><button id="saveIP">Connect</button></div><p class="note">Same Wi-Fi network required. This first build is read-only while we validate the Wi-Fi command protocol.</p><div class="muted" id="updated">No readings yet</div></section>
<section class="panel"><h2>Chambers</h2><div class="grid" id="chambers"></div></section>
<section class="panel"><h2>Meat probes</h2><div class="grid" id="probes"></div><p class="muted">960 = disconnected probe</p></section>
<section class="panel"><h2>Temperature history</h2><div class="row"><label>Range <select id="range"><option value="1800">30 min</option><option value="7200" selected>2 hr</option><option value="21600">6 hr</option><option value="86400">24 hr</option></select></label><button id="export">Export CSV</button></div><div id="legend" class="legend"></div><canvas id="chart"></canvas><p class="muted">History saved on this phone while the app is running. Up to 24 hours retained.</p></section>
<section class="panel"><h2>High / low alerts</h2><div id="rules"></div><button id="saveRules">Save limits</button><p class="muted">In-app alerts only while open. Not a safety monitoring system.</p></section>
<section class="panel"><h2>Cook session</h2><div id="cookInfo">No cook active</div><div class="row"><input id="cookName" placeholder="Brisket / ribs" maxlength="60"><button id="startCook">Start</button><button id="stopCook">End</button></div></section>
<section class="panel"><h2>Timers</h2><div class="row"><input id="timerName" placeholder="Wrap / rest" maxlength="50"><input id="minutes" type="number" min="1" max="1440" value="30"><button id="startTimer">Start</button></div><div id="timers"></div></section>
<section class="panel"><h2>Controller status</h2><div id="flags" class="flags"></div></section>
<section class="panel"><h2>Connection & alerts</h2><div id="events">Starting…</div><p class="warn">Do not rely on this app as a fire alarm or unattended-cooking safeguard. Grill control remains disabled until Wi-Fi command behavior is tested.</p></section>
<script>
const $=id=>document.getElementById(id),keys=['grillTemp','smokerActTemp','p_1_Temp','p_2_Temp','p_3_Temp','p_4_Temp'],names=['Main chamber','Upper cabinet','Probe 1','Probe 2','Probe 3','Probe 4'],colors=['#6eb5ff','#ffbd73','#7ce0ad','#d5a0fa','#ff8585','#f2df73'];
const get=(k,f)=>{try{return JSON.parse(localStorage.getItem(k))??f}catch(e){return f}},put=(k,v)=>localStorage.setItem(k,JSON.stringify(v));
let ip=get('ip','192.168.1.153'),history=get('history',[]),rules=get('rules',{}),timers=get('timers',[]),cook=get('cook',null),selected=get('selected',[true,true,false,false,false,false]),pending=0,busy=false,last=null,armed=new Set(),timerFired=new Set(),events=[];
$('ip').value=ip;
function valid(v){return typeof v==='number'&&v>=0&&v<900}function t(v){return valid(v)?v+'°F':'—'}
function log(s){events.unshift(new Date().toLocaleTimeString()+' · '+s);events=events.slice(0,12);$('events').textContent=events.join('\n')}
function alertUser(s){log('ALERT: '+s);if(navigator.vibrate)navigator.vibrate([200,100,200]);alert(s)}
function rpc(){if(busy)return;busy=true;const id=++pending;window.LockhartNative.rpc(ip,'GetState','{}',id);setTimeout(()=>{if(busy&&id===pending){busy=false;$('status').textContent='● Timeout';$('status').className='chip';log('No response from grill')}},6000)}
window.receiveRpc=function(id,body,error){if(id!==pending)return;busy=false;if(error){$('status').textContent='● Disconnected';$('status').className='chip';log(error);return}try{const outer=JSON.parse(body);if(outer.error&&outer.error.code!==0)throw Error('RPC '+outer.error.message);let d=outer.error&&outer.error.message?JSON.parse(outer.error.message):(outer.result||outer);if(!('grillTemp'in d))throw Error('No temperature data');last=d;const now=Date.now()/1000;history.push({t:now,...Object.fromEntries(keys.map(k=>[k,d[k]]))});history=history.filter(x=>x.t>now-86400).slice(-18000);put('history',history);$('status').textContent='● Connected';$('status').className='chip ok';$('updated').textContent='Updated '+new Date().toLocaleTimeString()+' · Setpoint '+t(d.grillSetTemp);drawTemps();drawChart();drawFlags();checkLimits();}catch(e){$('status').textContent='● Parse error';$('status').className='chip';log(e.message)}};
function drawTemps(){if(!last)return;function tile(k,i){return '<div class="tile"><div class="muted">'+names[i]+'</div><div class="value">'+t(last[k])+'</div></div>'}$('chambers').innerHTML=keys.slice(0,2).map((k,i)=>tile(k,i)).join('');$('probes').innerHTML=keys.slice(2).map((k,i)=>tile(k,i+2)).join('')}
function drawFlags(){const ks=['moduleIsOn','fanState','motorState','hotState','primeState','lightState','fanErr','motorErr','hotErr','tempHighErr','noPellets'];$('flags').innerHTML=ks.map(k=>'<span class="flag '+(last[k]?'on':'')+'">'+k+': '+(last[k]?'ON':'off')+'</span>').join('')}
function drawRules(){let s='';keys.forEach((k,i)=>{const r=rules[k]||{};s+='<div class="rule"><label>'+names[i]+'</label><div class="row"><input type="number" min="32" max="600" id="lo'+i+'" placeholder="Low" value="'+(r.low??'')+'"><input type="number" min="32" max="600" id="hi'+i+'" placeholder="High" value="'+(r.high??'')+'"></div></div>'});$('rules').innerHTML=s}
$('saveRules').onclick=()=>{let r={};for(let i=0;i<6;i++){let low=$('lo'+i).value,high=$('hi'+i).value;if(low&&(!Number.isFinite(+low)||+low<32||+low>600))return alert('Invalid low limit');if(high&&(!Number.isFinite(+high)||+high<32||+high>600))return alert('Invalid high limit');if(low&&high&&+low>=+high)return alert('Low must be below high');r[keys[i]]={low:low?+low:null,high:high?+high:null}}rules=r;armed.clear();put('rules',rules);log('Limits saved')};
function checkLimits(){if(!last)return;keys.forEach((k,i)=>{const v=last[k],r=rules[k]||{};if(!valid(v))return;for(const side of ['low','high']){const n=r[side];if(n===null||n===undefined)continue;const key=k+side,hit=side==='low'?v<=n:v>=n;if(hit&&!armed.has(key)){armed.add(key);alertUser(names[i]+' '+side+' alert: '+v+'°F (limit '+n+'°F)')}if(!hit&&(side==='low'?v>n+5:v<n-5))armed.delete(key)}})}
function legend(){ $('legend').innerHTML=keys.map((k,i)=>'<label style="color:'+colors[i]+'"><input type="checkbox" data-i="'+i+'" '+(selected[i]?'checked':'')+'>'+names[i]+'</label>').join('');$('legend').querySelectorAll('input').forEach(el=>el.onchange=()=>{selected[+el.dataset.i]=el.checked;put('selected',selected);drawChart()})}
function drawChart(){const c=$('chart'),w=Math.max(280,c.clientWidth),h=220,dpr=devicePixelRatio||1;c.width=w*dpr;c.height=h*dpr;const ctx=c.getContext('2d');ctx.scale(dpr,dpr);const now=Date.now()/1000,pts=history.filter(p=>p.t>=now-Number($('range').value)),values=pts.flatMap(p=>keys.filter((k,i)=>selected[i]&&valid(p[k])).map(k=>p[k]));if(values.length<2){ctx.fillStyle='#b5c5d4';ctx.fillText('Waiting for readings…',15,28);return}const min=Math.max(0,Math.floor((Math.min(...values)-20)/25)*25),max=Math.ceil((Math.max(...values)+20)/25)*25||100;for(let i=0;i<5;i++){let y=14+i*45;ctx.strokeStyle='#30404d';ctx.beginPath();ctx.moveTo(38,y);ctx.lineTo(w-8,y);ctx.stroke();ctx.fillStyle='#9eafbf';ctx.fillText(Math.round(max-(max-min)*i/4)+'°',3,y+4)}const start=now-Number($('range').value);keys.forEach((k,i)=>{if(!selected[i])return;ctx.beginPath();ctx.strokeStyle=colors[i];ctx.lineWidth=2;let active=false;pts.forEach(p=>{if(!valid(p[k])){active=false;return}let x=38+(w-48)*(p.t-start)/(now-start),y=14+180*(max-p[k])/(max-min||1);if(!active)ctx.moveTo(x,y);else ctx.lineTo(x,y);active=true});ctx.stroke()})}
function drawCook(){if(!cook){$('cookInfo').textContent='No cook active';return}const sec=Math.max(0,Math.floor(Date.now()/1000-cook.start));$('cookInfo').textContent=cook.name+' · '+Math.floor(sec/3600)+'h '+Math.floor(sec%3600/60)+'m '+sec%60+'s'}
$('startCook').onclick=()=>{cook={name:$('cookName').value.trim()||'Cook',start:Date.now()/1000};put('cook',cook);drawCook()};$('stopCook').onclick=()=>{cook=null;put('cook',cook);drawCook()};
function drawTimers(){const now=Date.now()/1000;$('timers').innerHTML=timers.map(x=>{const s=Math.max(0,Math.ceil(x.end-now));return '<div class="row" style="justify-content:space-between;margin:10px 0"><span>'+escapeHTML(x.name)+' · '+Math.floor(s/60)+':'+String(s%60).padStart(2,'0')+'</span><button data-id="'+x.id+'">Remove</button></div>'}).join('')||'<p class="muted">No timers</p>';$('timers').querySelectorAll('button').forEach(b=>b.onclick=()=>{timers=timers.filter(t=>t.id!==b.dataset.id);put('timers',timers);drawTimers()})}
function escapeHTML(x){return String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
$('startTimer').onclick=()=>{const m=+$('minutes').value;if(!Number.isFinite(m)||m<1||m>1440)return alert('Enter 1–1440 minutes');timers.push({id:String(Date.now()),name:$('timerName').value.trim()||'Timer',end:Date.now()/1000+m*60});put('timers',timers);drawTimers()};
function tick(){drawCook();drawTimers();const now=Date.now()/1000;timers.forEach(x=>{if(now>=x.end&&!timerFired.has(x.id)){timerFired.add(x.id);alertUser('Timer finished: '+x.name)}})}
$('saveIP').onclick=()=>{const s=$('ip').value.trim();if(!/^(\d{1,3}\.){3}\d{1,3}$/.test(s)||s.split('.').some(x=>+x>255))return alert('Invalid IPv4 address');ip=s;put('ip',ip);log('Using '+ip);rpc()};$('range').onchange=drawChart;
$('export').onclick=()=>{const csv=['time,'+keys.join(','),...history.map(x=>[new Date(x.t*1000).toISOString(),...keys.map(k=>x[k]??'')].join(','))].join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='lockhart-history.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
drawRules();legend();drawCook();drawTimers();drawChart();log('Monitoring only · no grill commands enabled');setInterval(rpc,5000);setInterval(tick,1000);rpc();
</script></body></html>