</style></head><body>
<div id="pvBanner"><img src="pitvoss_banner.png" alt="PitVoss Control"></div>
<button id="pvMenuButton" aria-label="Open menu" aria-expanded="false">☰</button>
<nav id="pvNav" aria-label="App views">
<button data-view="dashboard" class="active">Dashboard</button>
<button data-view="history">Temperature History</button>
<button data-view="alerts">High/Low Alerts</button>
<button data-view="controller">Controller Status</button>
<button data-view="addpit">Add a New Smoker</button>
<button data-view="connection">Connection &amp; Alerts</button>
</nav>
<main id="pvContent">
<div class="pvView active" id="view-dashboard">
<div class="row" style="justify-content:space-between;margin-bottom:8px"><div class="row"><div id="status" class="chip">Connecting…</div><div id="unitStatus" class="chip">UNIT UNKNOWN</div></div><span class="muted" id="updated">No readings yet</span></div>
<section class="panel pvControlPanel">
  <div class="pvSetpoint"><strong id="pvSetpoint" aria-label="Reported set temperature" aria-live="polite"></strong></div>
  <div class="pvSetTempRow"><label class="pvTempField" for="pvTargetTemp"><span>Degrees Fahrenheit (°F)</span><input id="pvTargetTemp" aria-label="Target grill temperature in Fahrenheit" type="number" min="160" max="500" step="5" value="225"></label><div class="pvSlide" id="pvTempSlide"><div class="pvSlideTrack"><span class="pvSlidePrompt">SLIDE TO START COOK →</span><button id="pvApplyTemp" type="button" class="pvSlideHandle" aria-label="Slide right to start cook at selected temperature">➜</button></div></div></div>
  <div id="pvCommandStatus" class="muted" role="status" aria-live="polite">Waiting for controller</div>
  <div class="pvControlGroup pvPowerGroup">
    <button id="pvPowerOn" type="button" title="Send controller power command"><span>Power On</span><span class="pvSmoke" id="pvSmoke" aria-hidden="true"><i></i><i></i><i></i></span></button>
    <button id="pvPowerOff" type="button" title="Send controller power command"><span>Power Off</span><span id="pvCoolingText" class="pvCoolingText" aria-hidden="true">Cooling Down</span></button>
  </div>
  <div class="pvControlGroup pvPrimeGroup"><button id="pvPrime" type="button" style="touch-action:manipulation">Prime</button><button id="pvStopPrime" type="button" class="pvPrimeStop">Stop Prime</button></div>
  <div id="pvPrimeStatus" class="muted" aria-live="polite">Prime idle</div>
  
</section><section class="panel"><div class="grid" id="chambers"></div></section>
<section class="panel"><h2>Meat Probes</h2><div class="grid" id="probes"></div><p class="muted">Disconnected probes display —</p></section>
<section class="panel"><h2>Cook Sessions</h2><div class="row"><input id="cookName" placeholder="Brisket / ribs" maxlength="60"><button id="startCook">Add Cook</button></div><div id="cookInfo"></div></section>
<section class="panel"><h2>Timers</h2><div class="pvTimerForm"><input id="timerName" placeholder="Timer name" aria-label="Timer name" maxlength="50"><input id="minutes" aria-label="Minutes" type="number" min="1" max="1440" value="30"><button id="startTimer">Start</button></div><div id="timers"></div></section>
</div>
<div class="pvView" id="view-history"><h2 class="pvViewTitle">Temperature History</h2><section class="panel"><div class="row"><label>Cook <select id="historyCook" aria-label="Cook session"></select></label><label>Range <select id="range"><option value="1800">30 min</option><option value="7200" selected>2 hr</option><option value="21600">6 hr</option><option value="86400">24 hr</option></select></label><button id="export">Export CSV</button></div><div id="legend" class="legend"></div><canvas id="chart"></canvas><p class="muted" id="historyInfo">Temperature readings are saved per cook session on this device. Start a cook to begin recording.</p></section></div>
<div class="pvView" id="view-alerts"><h2 class="pvViewTitle">High/Low Alerts</h2><section class="panel"><div id="rules"></div><button id="saveRules">Save limits</button><p class="muted">In-app alerts only while open. Not a safety monitoring system.</p></section></div>
<div class="pvView" id="view-controller"><h2 class="pvViewTitle">Controller Status</h2><section class="panel"><div id="flags" class="flags"></div></section></div>
<div class="pvView" id="view-addpit"><h2 class="pvViewTitle">Smoker Manager</h2>
<section class="panel"><h2>Find nearby grills</h2><p class="note">Scan for Bluetooth Low Energy devices. Likely Pit Boss controllers (PBG, PBM, PBL, PBC) appear first. Turn on your grill and enable Bluetooth.</p><div class="row"><button id="scanPits">Scan for Grills</button><span id="scanStatus" class="muted" aria-live="polite">Ready to scan</span></div><div id="pitResults"></div><details><summary>Other Bluetooth devices</summary><div id="otherBle"></div></details><p class="note">Selecting a device saves its Bluetooth address; it does not pair or configure Wi-Fi yet.</p></section>
<section class="panel"><h2>My Smokers</h2><p class="note">Select a saved smoker to view its details. Connected means its local Wi-Fi controller is responding; Bluetooth discovery alone does not establish a connection.</p><div id="savedPits"></div><div id="pitDetails" class="pvPitDetails" aria-live="polite"></div><div class="row"><label>Grill name <input id="pitNickname" type="text" maxlength="45" placeholder="Backyard Lockhart"></label><label>Wi-Fi IP <input id="pitIP" type="text" inputmode="decimal" placeholder="192.168.1.153"></label></div><div class="row"><button id="savePit">Save Grill</button><button id="removePit">Remove Selected</button></div><p class="note">Once the grill is on Wi-Fi, enter its IP to use the existing local connection. Bluetooth-to-Wi-Fi provisioning is not yet supported.</p></section></div>
<div class="pvView" id="view-connection"><h2 class="pvViewTitle">Connection &amp; Alerts</h2><section class="panel"><div class="row"><label>Grill IP <input type="text" id="ip" inputmode="decimal" placeholder="192.168.1.153"></label><button id="saveIP">Connect</button></div><p class="note">Same Wi-Fi network required. Commands are sent over local Wi-Fi; controller acknowledgement does not guarantee hardware actuation.</p></section><section class="panel"><div id="events">Starting…</div><p class="warn">Do not rely on this app as a fire alarm or unattended-cooking safeguard.</p></section></div>
</main>
<dialog id="pvPrimeDialog" class="pvPrimeDialog"><h2>Timed Prime</h2><p class="note">Choose a duration. Keep the smoker attended.</p><div class="pvPresetGrid"><button type="button" data-prime-seconds="30">30s</button><button type="button" data-prime-seconds="60">60s</button><button type="button" data-prime-seconds="90">90s</button><button type="button" data-prime-seconds="120">120s</button></div><div class="row"><button id="pvCancelPrime">Cancel</button></div></dialog>
<script>
const $=id=>document.getElementById(id),keys=['grillTemp','smokerActTemp','p_1_Temp','p_2_Temp','p_3_Temp','p_4_Temp'],names=['Grill','Cabinet','Probe 1','Probe 2','Probe 3','Probe 4'],colors=['#6eb5ff','#ffbd73','#7ce0ad','#d5a0fa','#ff8585','#f2df73'];
const get=(k,f)=>{try{return JSON.parse(localStorage.getItem(k))??f}catch(e){return f}},put=(k,v)=>localStorage.setItem(k,JSON.stringify(v));
let ip=get('ip',''),history=get('history',[]),cookHistory=get('cookHistory',{}),rules=get('rules',{}),timers=get('timers',[]),cooks=get('cooks',[]),selected=get('selected',[true,true,false,false,false,false]),pending=0,busy=false,last=null,armed=new Set(),timerFired=new Set(),events=[];
if(!Array.isArray(cooks))cooks=[];if(!cookHistory||typeof cookHistory!=='object'||Array.isArray(cookHistory))cookHistory={};const legacyCook=get('cook',null);if(legacyCook&&Number.isFinite(legacyCook.start)&&!get('cookMigrated',false)){cooks.push({...legacyCook,id:'legacy-'+legacyCook.start});put('cooks',cooks)}put('cookMigrated',true);
$('ip').value=ip;
// Controller commands are sent by the native bridge; visual indicators reflect GetState.
let controlRequest=300000,controlPending=false;
function commandStatus(message){$('pvCommandStatus').textContent=message;log(message)}
function sendControl(action,value=0){
 if(controlPending){commandStatus('Another command is pending');return}
 if(!ip||!window.LockhartNative?.control){commandStatus('Control unavailable: install updated Android bridge and connect');return}
 controlPending=true;const id=++controlRequest;
 commandStatus('Sending '+action+' to controller…');
 window.LockhartNative.control(ip,action,value,id);
 setTimeout(()=>{if(controlPending&&controlRequest===id){controlPending=false;commandStatus('No command response — verify at grill before retrying')}},8000);
}
window.receiveControl=function(id,action,body,error){
 if(id!==controlRequest)return;
 controlPending=false;
 if(error){commandStatus('FAILED '+action+': '+error);return}
 commandStatus('Controller acknowledged '+action+'; waiting for GetState verification');
 if(action==='powerOn'){const smoke=$('pvSmoke');smoke.classList.remove('puff');void smoke.offsetWidth;smoke.classList.add('puff');setTimeout(()=>smoke.classList.remove('puff'),1700)}
 if(action==='powerOff'){const el=$('pvCoolingText');el.classList.remove('float');void el.offsetWidth;el.classList.add('float');setTimeout(()=>el.classList.remove('float'),1900)}
 if(action==='setTemp')expectedSetpoint=Number($('pvTargetTemp').value);
 if(action==='powerOn')expectedPower=true;
 if(action==='powerOff')expectedPower=false;
 rpc();
};
let expectedPower=null,expectedSetpoint=null;
$('pvPowerOn').addEventListener('click',()=>{
 if(!last){commandStatus('Connect and get a valid reading before powering on');return}
 if(last.moduleIsOn===true){commandStatus('Controller already reports UNIT ON');return}
 if(!confirm('START THE SMOKER? Stay at the grill, inspect the burn pot, and follow the manufacturer ignition procedure.'))return;
 sendControl('powerOn');
});
$('pvPowerOff').addEventListener('click',()=>{
 if(!last){commandStatus('Connect and get a valid reading before shutting down');return}
 if(!confirm('Request NORMAL shutdown? Leave the grill powered for its cooling cycle.'))return;
 sendControl('powerOff');
});
function applyTargetTemperature(){
 const n=Number($('pvTargetTemp').value);
 if(!Number.isInteger(n)||n<160||n>500||n%5){commandStatus('Setpoint must be 160–500°F in 5°F steps');return}
 if(!last||last.moduleIsOn!==true){commandStatus('Grill must report UNIT ON to change temperature');return}
 if(last.isFahrenheit===false){commandStatus('Grill is in Celsius mode; Fahrenheit setpoint disabled');return}
 if(!confirm('Set grill target to '+n+'°F?'))return;
 sendControl('setTemp',n);
}

// Timed presets are enforced by native scheduler; held prime uses release-to-stop.
let primeRequest=200000,primeHolding=false,primeHoldTimer=null,primePointerDown=false,primeActive=false,primeUntil=0;
function primeStatus(s){$('pvPrimeStatus').textContent=s;document.body.classList.toggle('pvPriming',primeActive);log(s)}
function primeSend(action,seconds){
 if(!window.LockhartNative||!window.LockhartNative.prime||!last){primeStatus('Connect to grill before priming');return false}
 window.LockhartNative.prime(ip,action,seconds,++primeRequest);return true
}
window.receivePrime=function(id,action,body,error){
 if(error){primeStatus('Prime '+action+' error: '+error);if(action==='start')primeActive=false;return}
 if(action==='start'){primeActive=true;primeStatus('Prime command sent · check auger')}
 else if(action==='stop'){primeActive=false;primeUntil=0;primeStatus('Stop command sent · verify auger stopped')}
};
const primeButton=$('pvPrime'),primeDialog=$('pvPrimeDialog');
function primeRelease(){
 clearTimeout(primeHoldTimer);
 if(primeHolding){primeHolding=false;primeUntil=0;primeSend('stop',0)}
 primePointerDown=false;
}
primeButton.addEventListener('pointerdown',e=>{
 if(e.button!==0||primeActive)return;
 primePointerDown=true;primeHolding=false;
 try{primeButton.setPointerCapture(e.pointerId)}catch(_e){}
 primeHoldTimer=setTimeout(()=>{
  if(!primePointerDown)return;
  primeHolding=true;primeUntil=0;
  if(primeSend('start',0))primeStatus('Hold Prime · release to stop (120s maximum)');
 },450);
});
primeButton.addEventListener('pointerup',e=>{
 const wasHold=primeHolding;primeRelease();
 if(!wasHold&&!primeActive){primeDialog.showModal()}
});
primeButton.addEventListener('pointercancel',primeRelease);
primeButton.addEventListener('lostpointercapture',()=>{if(primePointerDown)primeRelease()});
$('pvCancelPrime').onclick=()=>primeDialog.close();
primeDialog.querySelectorAll('[data-prime-seconds]').forEach(button=>button.addEventListener('click',()=>{
 const sec=Number(button.dataset.primeSeconds);
 if(primeActive)return;
 primeDialog.close();
 if(!confirm('Start auger PRIME for '+sec+' seconds? Stay at the grill and watch the pellet feed.'))return;
 if(primeSend('start',sec)){primeUntil=Date.now()+sec*1000;primeStatus('Timed prime requested · '+sec+'s (check auger)')}
}));
$('pvStopPrime').onclick=()=>{primeRelease();primeUntil=0;primeSend('stop',0);primeStatus('Stop requested · check auger')};
window.addEventListener('pagehide',()=>{if(primeHolding)primeRelease()});

function valid(v){return typeof v==='number'&&v>=0&&v<900}function t(v){return valid(v)?v+'°F':'—'}
function log(s){events.unshift(new Date().toLocaleTimeString()+' · '+s);events=events.slice(0,12);$('events').textContent=events.join('\n')}
function alertUser(s){log('ALERT: '+s);if(navigator.vibrate)navigator.vibrate([200,100,200]);alert(s)}
function rpc(){if(busy||!ip)return;busy=true;const id=++pending;window.LockhartNative.rpc(ip,'GetState','{}',id);setTimeout(()=>{if(busy&&id===pending){busy=false;$('status').textContent='● Timeout';$('status').className='chip';drawUnit();renderPitDetails();log('No response from grill; retaining last confirmed state')}},6000)}
window.receiveRpc=function(id,body,error){if(id!==pending)return;busy=false;if(error){$('status').textContent='● Disconnected';$('status').className='chip';drawUnit();renderPitDetails();log(error);return}try{const outer=JSON.parse(body);if(outer.error&&outer.error.code!==0)throw Error('RPC '+outer.error.message);let d=outer.error&&outer.error.message?JSON.parse(outer.error.message):(outer.result||outer);if(!('grillTemp'in d))throw Error('No temperature data');last=d;const now=Date.now()/1000;history.push({t:now,...Object.fromEntries(keys.map(k=>[k,d[k]]))});history=history.filter(x=>x.t>now-86400).slice(-18000);put('history',history);for(const c of cooks.filter(c=>!c.end)){const samples=cookHistory[c.id]||(cookHistory[c.id]=[]);samples.push({t:now,...Object.fromEntries(keys.map(k=>[k,d[k]]))});if(samples.length>1800)samples.splice(0,samples.length-1800)}if(cooks.some(c=>!c.end)){try{put('cookHistory',cookHistory)}catch(storageError){log('Cook history storage full: '+storageError.message)}}$('status').textContent='● Connected';$('status').className='chip ok';$('updated').textContent='Updated '+new Date().toLocaleTimeString();drawSetpoint();drawUnit();renderPitDetails();drawTemps();drawChart();drawFlags();checkLimits();
 if(expectedPower!==null&&typeof d.moduleIsOn==='boolean'&&d.moduleIsOn===expectedPower){commandStatus('VERIFIED: controller reports UNIT '+(expectedPower?'ON':'OFF'));expectedPower=null}
 if(expectedSetpoint!==null&&d.grillSetTemp===expectedSetpoint){commandStatus('VERIFIED: grill setpoint '+expectedSetpoint+'°F');expectedSetpoint=null}}catch(e){$('status').textContent='● Parse error';$('status').className='chip';drawUnit();renderPitDetails();log(e.message)}};
function drawUnit(){const el=$('unitStatus');if(!last){el.textContent='UNIT UNKNOWN';el.className='chip';return}const on=last.moduleIsOn===true||last.moduleIsOn===1;el.textContent=on?'● UNIT ON':'○ UNIT OFF';el.className=on?'chip ok':'chip off';document.body.classList.toggle('pvUnitOn',on);document.body.classList.toggle('pvUnitOff',last.moduleIsOn===false||last.moduleIsOn===0);}
function drawSetpoint(){const on=last&&(last.moduleIsOn===true||last.moduleIsOn===1);const v=on?last.grillSetTemp:null;$('pvSetpoint').textContent=valid(v)&&v>0?t(v):''}
function drawTemps(){if(!last)return;
function tile(k,i){return '<div class="tile"><div class="muted">'+names[i]+'</div><div class="value">'+t(last[k])+'</div></div>'}
$('chambers').innerHTML=keys.slice(0,2).map((k,i)=>tile(k,i)).join('');
$('probes').innerHTML=keys.slice(2).map((k,i)=>tile(k,i+2)).join('')}

function drawFlags(){document.body.classList.toggle('pvPriming',last?.primeState===true||last?.primeState===1);const ks=['moduleIsOn','fanState','motorState','hotState','primeState','lightState','fanErr','motorErr','hotErr','tempHighErr','noPellets'];$('flags').innerHTML=ks.map(k=>'<span class="flag '+(last[k]?'on':'')+'">'+k+': '+(last[k]?'ON':'off')+'</span>').join('')}
function drawRules(){let s='';keys.forEach((k,i)=>{const r=rules[k]||{};s+='<div class="rule"><label>'+names[i]+'</label><div class="row"><input type="number" min="32" max="600" id="lo'+i+'" placeholder="Low" value="'+(r.low??'')+'"><input type="number" min="32" max="600" id="hi'+i+'" placeholder="High" value="'+(r.high??'')+'"></div></div>'});$('rules').innerHTML=s}
$('saveRules').onclick=()=>{let r={};for(let i=0;i<6;i++){let low=$('lo'+i).value,high=$('hi'+i).value;if(low&&(!Number.isFinite(+low)||+low<32||+low>600))return alert('Invalid low limit');if(high&&(!Number.isFinite(+high)||+high<32||+high>600))return alert('Invalid high limit');if(low&&high&&+low>=+high)return alert('Low must be below high');r[keys[i]]={low:low?+low:null,high:high?+high:null}}rules=r;armed.clear();put('rules',rules);log('Limits saved')};
function checkLimits(){if(!last)return;keys.forEach((k,i)=>{const v=last[k],r=rules[k]||{};if(!valid(v))return;for(const side of ['low','high']){const n=r[side];if(n===null||n===undefined)continue;const key=k+side,hit=side==='low'?v<=n:v>=n;if(hit&&!armed.has(key)){armed.add(key);alertUser(names[i]+' '+side+' alert: '+v+'°F (limit '+n+'°F)')}if(!hit&&(side==='low'?v>n+5:v<n-5))armed.delete(key)}})}
function legend(){ $('legend').innerHTML=keys.map((k,i)=>'<label style="color:'+colors[i]+'"><input type="checkbox" data-i="'+i+'" '+(selected[i]?'checked':'')+'>'+names[i]+'</label>').join('');$('legend').querySelectorAll('input').forEach(el=>el.onchange=()=>{selected[+el.dataset.i]=el.checked;put('selected',selected);drawChart()})}
function drawChart(){const c=$('chart'),w=Math.max(280,c.clientWidth),h=220,dpr=devicePixelRatio||1;c.width=w*dpr;c.height=h*dpr;const ctx=c.getContext('2d');ctx.scale(dpr,dpr);const cook=cooks.find(c=>c.id===$('historyCook').value),now=Date.now()/1000,finish=cook?(cook.end||now):now,pts=(cook?(cookHistory[cook.id]||[]):[]).filter(p=>p.t>=Math.max(cook.start,finish-Number($('range').value))&&p.t<=finish),values=pts.flatMap(p=>keys.filter((k,i)=>selected[i]&&valid(p[k])).map(k=>p[k]));if(values.length<2){ctx.fillStyle='#b5c5d4';ctx.fillText(cook?'Waiting for this cook’s readings…':'Select a cook session',15,28);return}const min=Math.max(0,Math.floor((Math.min(...values)-20)/25)*25),max=Math.ceil((Math.max(...values)+20)/25)*25||100;for(let i=0;i<5;i++){let y=14+i*45;ctx.strokeStyle='#30404d';ctx.beginPath();ctx.moveTo(38,y);ctx.lineTo(w-8,y);ctx.stroke();ctx.fillStyle='#9eafbf';ctx.fillText(Math.round(max-(max-min)*i/4)+'°',3,y+4)}const start=Math.max(cook.start,finish-Number($('range').value));keys.forEach((k,i)=>{if(!selected[i])return;ctx.beginPath();ctx.strokeStyle=colors[i];ctx.lineWidth=2;let active=false;pts.forEach(p=>{if(!valid(p[k])){active=false;return}let x=38+(w-48)*(p.t-start)/(finish-start||1),y=14+180*(max-p[k])/(max-min||1);if(!active)ctx.moveTo(x,y);else ctx.lineTo(x,y);active=true});ctx.stroke()})}
function drawCook(){const now=Date.now()/1000;$('cookInfo').innerHTML=cooks.map(c=>{const sec=Math.max(0,Math.floor((c.end??now)-c.start));const elapsed=Math.floor(sec/3600)+'h '+Math.floor(sec%3600/60)+'m '+sec%60+'s';return '<div class="pvEntry"><div class="pvEntryText"><strong>'+escapeHTML(c.name)+'</strong><small>'+elapsed+(c.end?' · Finished':' · Running')+'</small></div><button data-cook-id="'+escapeHTML(c.id)+'">'+(c.end?'Remove':'End')+'</button></div>'}).join('')||'<p class="muted">No cook sessions</p>';$('cookInfo').querySelectorAll('button').forEach(b=>b.onclick=()=>{const c=cooks.find(c=>c.id===b.dataset.cookId);if(!c)return;if(c.end){if(!confirm('Remove this cook and its saved temperature history?'))return;cooks=cooks.filter(x=>x.id!==c.id);delete cookHistory[c.id];put('cookHistory',cookHistory)}else c.end=Date.now()/1000;put('cooks',cooks);drawCook();refreshCookHistory()})}
$('startCook').onclick=()=>{cooks.push({id:'cook-'+Date.now()+'-'+Math.random().toString(36).slice(2),name:$('cookName').value.trim()||'Cook',start:Date.now()/1000});$('cookName').value='';put('cooks',cooks);drawCook();refreshCookHistory(true)};
function drawTimers(){const now=Date.now()/1000;$('timers').innerHTML=timers.map(x=>{const s=Math.max(0,Math.ceil(x.end-now));return '<div class="row" style="justify-content:space-between;margin:10px 0"><span>'+escapeHTML(x.name)+' · '+Math.floor(s/60)+':'+String(s%60).padStart(2,'0')+'</span><button data-id="'+x.id+'">Remove</button></div>'}).join('')||'<p class="muted">No timers</p>';$('timers').querySelectorAll('button').forEach(b=>b.onclick=()=>{timers=timers.filter(t=>t.id!==b.dataset.id);put('timers',timers);drawTimers()})}
function escapeHTML(x){return String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
$('startTimer').onclick=()=>{const m=+$('minutes').value;if(!Number.isFinite(m)||m<1||m>1440)return alert('Enter 1–1440 minutes');timers.push({id:'timer-'+Date.now()+'-'+Math.random().toString(36).slice(2),name:$('timerName').value.trim()||'Timer',end:Date.now()/1000+m*60});put('timers',timers);drawTimers()};
function tick(){if(primeUntil&&Date.now()>=primeUntil){primeUntil=0;primeStatus('Prime timer elapsed; waiting for native auto-stop confirmation')}else if(primeUntil){$('pvPrimeStatus').textContent='Timed prime · '+Math.ceil((primeUntil-Date.now())/1000)+'s remaining'}drawCook();drawTimers();const now=Date.now()/1000;timers.forEach(x=>{if(now>=x.end&&!timerFired.has(x.id)){timerFired.add(x.id);alertUser('Timer finished: '+x.name)}})}
function refreshCookHistory(selectNewest=false){const sel=$('historyCook'),old=sel.value;sel.innerHTML=cooks.slice().reverse().map(c=>'<option value="'+escapeHTML(c.id)+'">'+escapeHTML(c.name)+(c.end?' · Finished':' · Running')+'</option>').join('');if(!cooks.length)sel.innerHTML='<option value="">No cook sessions</option>';if(!selectNewest&&cooks.some(c=>c.id===old))sel.value=old;const c=cooks.find(c=>c.id===sel.value);$('historyInfo').textContent=c?'Showing saved readings for '+c.name+'. Readings are recorded while the app is connected and polling.':'Start a cook to begin recording temperature history.';drawChart()}
$('historyCook').onchange=()=>refreshCookHistory();
// Slide-to-confirm setpoint: dragging is required; keyboard users can focus the handle and press Enter.
(function(){const track=$('pvTempSlide').querySelector('.pvSlideTrack'),handle=$('pvApplyTemp');let dragging=false,origin=0,max=0;const reset=()=>{dragging=false;handle.style.transform='translateX(0px)';track.classList.remove('pvSliding')};handle.addEventListener('pointerdown',e=>{if(controlPending)return;dragging=true;origin=e.clientX;max=Math.max(0,track.clientWidth-handle.offsetWidth-8);handle.setPointerCapture(e.pointerId);track.classList.add('pvSliding')});handle.addEventListener('pointermove',e=>{if(!dragging)return;const dx=Math.max(0,Math.min(max,e.clientX-origin));handle.style.transform='translateX('+dx+'px)'});handle.addEventListener('pointerup',e=>{if(!dragging)return;const passed=max>20&&(e.clientX-origin)>=max*.85;reset();if(passed)applyTargetTemperature()});handle.addEventListener('pointercancel',reset);handle.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();applyTargetTemperature()}});})();
$('saveIP').onclick=()=>{const s=$('ip').value.trim();if(!/^(\d{1,3}\.){3}\d{1,3}$/.test(s)||s.split('.').some(x=>+x>255))return alert('Invalid IPv4 address');ip=s;put('ip',ip);log('Using '+ip);rpc()};$('range').onchange=drawChart;
$('export').onclick=()=>{const c=cooks.find(c=>c.id===$('historyCook').value);if(!c)return alert('Select a cook first');const csv=['time,'+keys.join(','),...(cookHistory[c.id]||[]).map(x=>[new Date(x.t*1000).toISOString(),...keys.map(k=>x[k]??'')].join(','))].join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='pitvoss-'+c.name.replace(/[^a-z0-9_-]/gi,'_')+'-history.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
drawRules();legend();drawSetpoint();drawUnit();drawCook();drawTimers();refreshCookHistory();log('Controller ready for live commands');setInterval(rpc,5000);setInterval(tick,1000);rpc();


// Native BLE discovery; pairing/provisioning intentionally not claimed.
let foundPits=[],savedPits=get('savedPits',[]),selectedPit=get('selectedPit','');
if(!Array.isArray(savedPits))savedPits=[];
const pitPrefixes=['PBG','PBM','PBL','PBC'];
const validIP=s=>/^(\d{1,3}\.){3}\d{1,3}$/.test(s)&&s.split('.').every(x=>+x<=255);
function renderPitList(){
 const likely=foundPits.filter(d=>pitPrefixes.some(p=>(d.name||'').toUpperCase().startsWith(p)));
 const other=foundPits.filter(d=>!likely.includes(d));
 function rows(arr){return arr.map(d=>'<div class="pvEntry"><div class="pvEntryText"><strong>'+escapeHTML(d.name||'Unnamed device')+'</strong><small>'+escapeHTML(d.address)+' · '+d.rssi+' dBm'+(d.services?.length?' · '+d.services.length+' services':'')+'</small></div><button data-ble="'+escapeHTML(d.address)+'">Select</button></div>').join('')||'<p class="muted">No devices found</p>'}
 $('pitResults').innerHTML=rows(likely);$('otherBle').innerHTML=rows(other);
 document.querySelectorAll('[data-ble]').forEach(b=>b.onclick=()=>{const d=foundPits.find(x=>x.address===b.dataset.ble);if(!d)return;selectedPit=d.address;$('pitNickname').value=d.name||'My Pit Boss';$('scanStatus').textContent='Selected '+(d.name||d.address);renderSavedPits()});
}
function pitIdentity(d){return d.address||'ip:'+d.ip}
function pitModelFromState(d){
 if(!d||typeof d!=='object')return '';
 for(const k of ['modelNumber','model_number','modelNo','model','grillModel','deviceModel']){
  if(typeof d[k]==='string'&&d[k].trim())return d[k].trim();
 }
 return '';
}
function renderPitDetails(){
 const d=savedPits.find(x=>pitIdentity(x)===selectedPit);
 const panel=$('pitDetails');
 if(!d){panel.innerHTML='<span class="muted">Select a smoker above to view its information.</span>';return}
 const wifiConnected=!!(d.ip&&d.ip===ip&&last);
 const model=wifiConnected?pitModelFromState(last):'';
 const found=foundPits.find(x=>x.address===d.address);
 const lines=[
 ['Name',d.nickname],
 ['Connection',wifiConnected?'Connected over Wi-Fi':'Not connected over Wi-Fi'],
 ['Model number',model||'Not provided by controller'],
 ['Bluetooth name',d.bleName||found?.name||'Not available'],
 ['Bluetooth address',d.address||'Not available'],
 ['Wi-Fi IP',d.ip||'Not configured'],
 ['Signal',found?found.rssi+' dBm (last scan)':'Not currently scanned'],
 ['BLE services',found?.services?.length?found.services.join(', '):'Not advertised / not available']
 ];
 panel.innerHTML='<dl>'+lines.map(([k,v])=>'<dt>'+escapeHTML(k)+'</dt><dd>'+escapeHTML(v)+'</dd>').join('')+'</dl>';
}
function renderSavedPits(){
 $('savedPits').innerHTML=savedPits.map(d=>'<div class="pvEntry"><div class="pvEntryText"><strong>'+escapeHTML(d.nickname)+'</strong><small>'+escapeHTML(d.address||'Manual IP')+(d.ip?' · '+escapeHTML(d.ip):'')+'</small></div><button data-saved="'+escapeHTML(pitIdentity(d))+'">'+(pitIdentity(d)===selectedPit?'Selected':'View / Use')+'</button></div>').join('')||'<p class="muted">No saved smokers yet</p>';
 document.querySelectorAll('[data-saved]').forEach(b=>b.onclick=()=>{const d=savedPits.find(x=>pitIdentity(x)===b.dataset.saved);if(!d)return;selectedPit=b.dataset.saved;$('pitNickname').value=d.nickname;$('pitIP').value=d.ip||'';put('selectedPit',selectedPit);if(d.ip){ip=d.ip;put('ip',ip);$('ip').value=ip;last=null;rpc()}renderSavedPits()});
 renderPitDetails();
}
window.receiveBle=function(kind,payload){
 if(kind==='device'){try{const d=JSON.parse(payload);const i=foundPits.findIndex(x=>x.address===d.address);if(i<0)foundPits.push(d);else foundPits[i]=d;foundPits.sort((a,b)=>b.rssi-a.rssi);renderPitList();renderPitDetails()}catch(e){log('BLE data error: '+e.message)}}
 else{$('scanStatus').textContent=payload;log('BLE: '+payload)}
};
$('scanPits').onclick=()=>{foundPits=[];renderPitList();$('scanStatus').textContent='Starting scan…';if(window.LockhartNative&&window.LockhartNative.scanBle)window.LockhartNative.scanBle();else $('scanStatus').textContent='Android Bluetooth bridge not installed'};
$('savePit').onclick=()=>{const address=selectedPit.startsWith('ip:')?'':selectedPit;const pitIP=$('pitIP').value.trim();if(pitIP&&!validIP(pitIP))return alert('Enter a valid IPv4 address');if(!address&&!pitIP)return alert('Select a Bluetooth device or enter a grill IP');const nickname=$('pitNickname').value.trim()||'My Pit Boss';const key=address||'ip:'+pitIP;const found=foundPits.find(x=>x.address===address);const previous=savedPits.find(x=>pitIdentity(x)===key);const d={address,nickname,ip:pitIP,bleName:found?.name||previous?.bleName||''};savedPits=savedPits.filter(x=>(x.address||'ip:'+x.ip)!==key);savedPits.push(d);put('savedPits',savedPits);selectedPit=key;put('selectedPit',key);if(pitIP){ip=pitIP;put('ip',ip);$('ip').value=ip;rpc()}renderSavedPits();$('scanStatus').textContent='Saved '+nickname};
$('removePit').onclick=()=>{if(!selectedPit)return;const before=savedPits.length;savedPits=savedPits.filter(x=>(x.address||'ip:'+x.ip)!==selectedPit);if(savedPits.length===before)return;put('savedPits',savedPits);selectedPit='';put('selectedPit','');$('pitNickname').value='';$('pitIP').value='';renderSavedPits()};
renderPitList();renderSavedPits();
// Give all buttons tactile feedback, including the control buttons.
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;b.classList.remove('pvFlash');void b.offsetWidth;b.classList.add('pvFlash');setTimeout(()=>b.classList.remove('pvFlash'),560)});

const pvNav=$('pvNav'),pvMenuButton=$('pvMenuButton');
function pvOpen(view){document.querySelectorAll('.pvView').forEach(v=>v.classList.toggle('active',v.id==='view-'+view));pvNav.querySelectorAll('button').forEach(b=>b.classList.toggle('active',b.dataset.view===view));pvNav.classList.remove('open');pvMenuButton.setAttribute('aria-expanded','false');window.scrollTo(0,0);if(view==='history')setTimeout(refreshCookHistory,0)}
pvMenuButton.onclick=()=>{const open=pvNav.classList.toggle('open');pvMenuButton.setAttribute('aria-expanded',String(open))};
pvNav.querySelectorAll('button').forEach(b=>b.onclick=()=>pvOpen(b.dataset.view));
