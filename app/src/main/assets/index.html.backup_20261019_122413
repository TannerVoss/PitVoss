}
button:not(.pvSlideHandle):not(.pvControlGroup button):disabled{opacity:.55}
/* Keep navigation legible and visually distinguish the current screen. */
#pvNav button.active{background:linear-gradient(145deg,#e4ebee,#9baab3)!important;color:#0d1820!important}
#pvNav button{width:100%}
.pvSlidePrompt{font-size:10px;letter-spacing:0;left:53px;right:2px;top:18px}
@media(max-width:390px){.pvTempField{flex-basis:103px}.pvSlidePrompt{font-size:9px;left:51px}}
