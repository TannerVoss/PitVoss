/* Knurled stainless controller hardware + consistent tactile form controls */
.pvControlGroup button{
  isolation:isolate;
  border:7px solid #7e898f!important;
  background:radial-gradient(circle at 35% 23%,#3b444b 0%,#161d23 43%,#080b0e 80%)!important;
  box-shadow:inset 0 0 0 3px #11171c,inset 0 4px 9px #ffffff20,inset 0 -10px 16px #000,
             0 0 0 2px #c6cdd0,0 5px 0 #525d64,0 9px 15px #000b;
}
/* A machined, 48-tooth outer grip. Ring mask keeps the center readable. */
.pvControlGroup button::before{
  content:'';position:absolute;inset:-13px;border:0;border-radius:50%;pointer-events:none;
  background:repeating-conic-gradient(from 1deg,#f1f4f5 0deg 2deg,#88959c 2deg 4deg,#424c53 4deg 6deg,#aab4b9 6deg 7.5deg);
  -webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 11px),#000 calc(100% - 10px));
  mask:radial-gradient(farthest-side,transparent calc(100% - 11px),#000 calc(100% - 10px));
  filter:drop-shadow(0 2px 2px #000a);z-index:-1;
}
.pvControlGroup button::after{top:9px;height:13px;width:4px;background:linear-gradient(90deg,#6b747a,#f1f3f4,#879299)}
.pvControlGroup button:active{transform:translateY(2px) rotate(2deg)}
.pvControlGroup button:focus-visible{outline:3px solid #b7d6ec;outline-offset:17px}
