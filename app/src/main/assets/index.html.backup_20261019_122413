  color:#f0f4f7;min-height:44px;
}
input:not([type=checkbox]):focus,select:focus,textarea:focus{outline:2px solid #9fc6df;outline-offset:1px}
/* Match the metallic slider handle on all regular actions, not on the dials. */
button:not(.pvSlideHandle):not(.pvControlGroup button){
  background:linear-gradient(145deg,#e1e7eb 0%,#9eabb4 42%,#667781 100%)!important;
  color:#101820!important;border:1px solid #e2e9ed!important;
